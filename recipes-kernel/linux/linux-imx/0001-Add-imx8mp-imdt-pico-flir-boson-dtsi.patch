From a0fe434362d4620132b0e9ec1b7e45c485f9830d Mon Sep 17 00:00:00 2001
From: Russell Bateman <russell.bateman@imd-tec.com>
Date: Wed, 27 May 2026 15:13:19 +0100
Subject: [PATCH] Add imx8mp-imdt-pico-flir-boson dtsi

---
 .../imx8mp-imdt-pico-flir-boson.dtsi          | 80 +++++++++++++++++++
 .../boot/dts/freescale/imx8mp-imdt-pico.dtsi  |  2 +
 2 files changed, 82 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtsi

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtsi
new file mode 100644
index 000000000000..4b4fee33304d
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtsi
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * FLIR Boson / Boson+ thermal camera
+ * Connected on:
+ *   - I2C3(4)   (control, address 0x6a)
+ *   - MIPI CSI1 (image data, 2 lanes)
+ *   - ISP2_RSTn (reset line, GPIO 1, IO 22)
+ */
+
+ &iomuxc {
+     pinctrl_csi1_rst: csi1_rst_grp {
+         fsl,pins = <
+             MX8MP_IOMUXC_ENET_TX_CTL__GPIO1_IO22    0x19
+         >;
+     };
+ };
+
+&mipi_csi_1 {
+    #address-cells = <1>;
+    #size-cells = <0>;
+    assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_266M>;
+    assigned-clock-rates = <266000000>;
+    status = "okay";
+
+
+    port@0 {
+        reg = <0>;
+        mipi_csi1_ep: endpoint {
+            remote-endpoint = <&mipi_0_ep>;
+            data-lanes = <2>;
+            csis-hs-settle = <13>;
+            csis-clk-settle = <2>;
+            csis-wclk;
+        };
+    };
+
+    port@1 {
+        reg = <1>;
+        mipi_csi1_out: endpoint {
+            remote-endpoint = <&isi_in_1>;
+        };
+    };
+};
+
+&i2c4 {
+    #address-cells = <1>;
+    #size-cells = <0>;
+    flir_boson_0: flir_boson_0@6a {
+        compatible = "flir,boson-mipi";
+        reg = <0x6a>;
+        csi_id = <1>;
+        reset-gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_csi1_rst>;
+        status = "okay";
+
+        port {
+            mipi_0_ep: endpoint {
+                remote-endpoint = <&mipi_csi1_ep>;
+                data-lanes = <1 2>;
+            };
+        };
+    };
+};
+
+
+&isi_0 {
+    ports {
+        port@1 {
+            reg = <1>;
+    		isi_in_1: endpoint {
+    			remote-endpoint = <&mipi_csi1_out>;
+    		};
+    	};
+    };
+};
+
+&cameradev {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico.dtsi
index 7ed3d80d788e..d2ce05b818cd 100755
--- a/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico.dtsi
@@ -10,6 +10,8 @@
 #include <dt-bindings/usb/pd.h>
 #include "imx8mp.dtsi"
 
+#include "imx8mp-imdt-pico-flir-boson.dtsi"
+
 / {
 	model = "IMD Technologies Pico-EM Board";
 	compatible = "imdt,imx8mp-imdt-pico-em", "fsl,imx8mp";
