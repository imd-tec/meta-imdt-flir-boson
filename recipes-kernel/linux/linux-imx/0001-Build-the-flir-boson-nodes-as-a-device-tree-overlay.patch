From 8c5135fcd74763a0f295d4d8766dfdc3435f4af3 Mon Sep 17 00:00:00 2001
From: Russell Bateman <russell.bateman@imd-tec.com>
Date: Tue, 7 Jul 2026 16:37:00 +0100
Subject: [PATCH] Build the flir-boson nodes as a device tree overlay, rather
 than including it directly into the base device tree.

---
 arch/arm64/boot/dts/freescale/Makefile        |  4 +
 ...mx8mp-imdt-pico-flir-boson-standalone.dtso | 17 ++++
 .../imx8mp-imdt-pico-flir-boson.dtso          | 92 +++++++++++++++++++
 3 files changed, 113 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson-standalone.dtso
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtso

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 5e6ce8e5b05f..c578848bf2af 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -214,11 +214,15 @@ DTC_FLAGS_imx8mp-imdt-pico-e:=-@
 DTC_FLAGS_imx8mp-imdt-pico-ar0521:=-@
 DTC_FLAGS_imx8mp-imdt-pico-display-HDMI:=-@
 DTC_FLAGS_imx8mp-imdt-pico-display-DSI:=-@
+DTC_FLAGS_imx8mp-imdt-pico-flir-boson:=-@
+DTC_FLAGS_imx8mp-imdt-pico-flir-boson-standalone:=-@
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-imdt-pico.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-imdt-pico-e.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-imdt-pico-ar0521.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-imdt-pico-display-HDMI.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-imdt-pico-display-DSI.dtbo
+dtb-$(CONFIG_ARCH_MXC) += imx8mp-imdt-pico-flir-boson.dtbo
+dtb-$(CONFIG_ARCH_MXC) += imx8mp-imdt-pico-flir-boson-standalone.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx8mq-evk.dtb imx8mq-evk-rpmsg.dtb imx8mq-evk-pcie1-m2.dtb imx8mq-evk-usd-wifi.dtb \
 			  imx8mq-evk-usdhc2-m2.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mq-evk-ak4497.dtb imx8mq-evk-audio-tdm.dtb imx8mq-evk-pdm.dtb
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson-standalone.dtso b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson-standalone.dtso
new file mode 100644
index 000000000000..0688336acb49
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson-standalone.dtso
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2026 IMD Technologies
+
+ */
+
+#include "imx8mp-imdt-pico-flir-boson.dtso"
+
+/*
+ * Disable the AP1302 ISP for systems that want to use the FLIR Boson camera as a standalone camera.
+ */
+
+&i2c4 {
+	camera@3c {
+		status = "disabled";
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtso b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtso
new file mode 100644
index 000000000000..2f3adf9949be
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-imdt-pico-flir-boson.dtso
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2026 IMD Technologies
+
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/imx8mp-clock.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "imx8mp-pinfunc.h"
+
+/*
+ * FLIR Boson / Boson+ thermal camera
+ * Connected on:
+ *   - I2C3(4)   (control, address 0x6a)
+ *   - MIPI CSI1 (image data, 2 lanes)
+ *   - ISP2_RSTn (reset line, GPIO 1, IO 22)
+ */
+
+&iomuxc {
+    pinctrl_csi1_rst: csi1_rst_grp {
+        fsl,pins = <
+             MX8MP_IOMUXC_ENET_TX_CTL__GPIO1_IO22    0x19
+        >;
+    };
+};
+
+&mipi_csi_1 {
+    #address-cells = <1>;
+    #size-cells = <0>;
+    assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_266M>;
+    assigned-clock-rates = <266000000>;
+    status = "okay";
+
+
+    port@0 {
+        reg = <0>;
+        mipi_csi1_ep: endpoint {
+            remote-endpoint = <&mipi_0_ep>;
+            data-lanes = <2>;
+            csis-hs-settle = <13>;
+            csis-clk-settle = <2>;
+            csis-wclk;
+        };
+    };
+
+    port@1 {
+        reg = <1>;
+        mipi_csi1_out: endpoint {
+            remote-endpoint = <&isi_in_1>;
+        };
+    };
+};
+
+&i2c4 {
+    #address-cells = <1>;
+    #size-cells = <0>;
+    flir_boson_0: flir_boson_0@6a {
+        compatible = "flir,boson-mipi";
+        reg = <0x6a>;
+        csi_id = <1>;
+        reset-gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_csi1_rst>;
+        status = "okay";
+
+        port {
+            mipi_0_ep: endpoint {
+                remote-endpoint = <&mipi_csi1_ep>;
+                data-lanes = <1 2>;
+            };
+        };
+    };
+};
+
+
+&isi_0 {
+    ports {
+        port@1 {
+            reg = <1>;
+            isi_in_1: endpoint {
+                remote-endpoint = <&mipi_csi1_out>;
+            };
+        };
+    };
+};
+
+&cameradev {
+    status = "okay";
+};
